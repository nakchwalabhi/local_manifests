<?xml version="1.0" encoding="UTF-8"?>
<!--
  fogos (Motorola moto g34 5G / SM6375 "blair") - kernel-platform manifest.
  Standalone kernel build (no AOSP/Lineage framework).
  Adapted from Samsung-QTI/manifest : release/kernel.xml (the working blair
  6.1 reference device, gta9pwifi).

  Produces the ACK/kleaf "kernel platform" layout:
    kernel_platform/msm-kernel     the fogos 6.1 kernel (your fork)
    kernel_platform/devicetrees    fogos DTs, linked into the kernel tree
    kernel_platform/build/kernel   ACK build scripts (kernel/build)
    kernel_platform/config         build config (build.sh)
    kernel_platform/external/dtc   dtc
    kernel_platform/prebuilts/...  clang, build-tools, bazel, mkbootimg (CLO-LA)

  Sync:
    mkdir fogos-kernel && cd fogos-kernel
    repo init -u https://github.com/nakchwalabhi/local_manifests -b lineage-23.1 -m fogos-kernel-platform.xml
    repo sync -c -j8

  Build (see BUILD-FOGOS-6.1.md, Route B):
    cd kernel_platform
    BUILD_CONFIG=msm-kernel/build.config.msm.blair build/build.sh

  NOTE: if the build complains that kernel_platform/common is missing, add the
  ACK common kernel repo (the reference keeps common and msm-kernel separate).
-->
<manifest>
  <remote fetch="https://github.com/nakchwalabhi"      name="nakchwal"/>
  <remote fetch="https://github.com/Samsung-QTI"       name="sqti"/>
  <remote fetch="https://github.com/Samsung-QTI-Blair" name="sqti-blair"/>
  <remote fetch="https://git.codelinaro.org/clo/la"    name="clo-la"/>

  <!-- MSM kernel (fogos 6.1 fork) -->
  <project remote="nakchwal" name="android_kernel_motorola_sm6375-6.1"
           path="kernel_platform/msm-kernel" revision="6.1/fogos-port"/>

  <!-- fogos device trees, linked into the kernel tree -->
  <project remote="nakchwal" name="android_kernel_motorola_sm6375-devicetrees"
           path="kernel_platform/devicetrees" revision="6.1/fogos-port">
    <linkfile dest="kernel_platform/msm-kernel/arch/arm64/boot/dts/vendor/qcom" src="qcom"/>
  </project>

  <!-- ACK/QCOM kernel build scripts + config + dtc (tooling the fogos kernel repo lacks) -->
  <project remote="sqti"       name="android_kernel_build"
           path="kernel_platform/build/kernel" revision="kernel.lnx.6.1.r46-rel"/>
  <project remote="sqti-blair" name="android_kernel_platform_build_config"
           path="kernel_platform/config" revision="P86803AA1"/>
  <project remote="sqti-blair" name="android_kernel_platform_external_dtc"
           path="kernel_platform/external/dtc" revision="kernel.build.lnx.2.0.r4-rel"/>

  <!-- CLO-LA prebuilts (verbatim from the reference kernel.xml) -->
  <project remote="clo-la" name="kernel/prebuilts/build-tools" path="kernel_platform/prebuilts/kernel-build-tools" revision="3892d2c393135d568c9140c801623530eea4104c" upstream="refs/heads/ks-kernel.lnx.3.0.r6-rel">
    <linkfile dest="kernel_platform/build/prebuilts/kernel-build-tools" src="."/>
  </project>
