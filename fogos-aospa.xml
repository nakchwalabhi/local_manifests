<?xml version="1.0" encoding="UTF-8"?>
<!--
  AOSPA "beryl" (Android 16 QPR0) local manifest for the Motorola moto g34 5G (fogos).

  This file contains ONLY AOSPA-source overrides. All fogos device dependencies
  (device trees, kernel, hardware, vendor blobs) are declared in
  vendor/aospa/products/fogos/beans.xml and synced by AOSPA's barista on lunch.

  Overrides:
   * vendor/aospa            -> fork that registers the aospa_fogos product
   * packages/resources/devicesettings -> fork that adds the Lineage-compatible
                                 "org.lineageos.settings.resources" module (and the
                                 "none" string) needed by Lineage's MotoActions /
                                 StylusKeyHandler.

  Use with the AOSPA "beryl" branch:
      repo init -u https://github.com/AOSPA/manifest -b beryl
-->
<manifest>

  <remote name="fogos-gh" fetch="https://github.com/nakchwalabhi" revision="beryl" />

  <!-- AOSPA vendor config: the fork that registers the aospa_fogos product -->
  <remove-project name="AOSPA/android_vendor_aospa" />
  <project path="vendor/aospa"
           name="android_vendor_aospa"
           remote="fogos-gh" revision="beryl" />

  <!-- Device-settings resources: fork adds org.lineageos.settings.resources -->
  <remove-project name="AOSPA/android_packages_resources_devicesettings" />
  <project path="packages/resources/devicesettings"
           name="android_packages_resources_devicesettings"
           remote="fogos-gh" revision="beryl" />

</manifest>
