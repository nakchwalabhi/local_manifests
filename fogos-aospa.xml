<?xml version="1.0" encoding="UTF-8"?>
<!--
  AOSPA "beryl" (Android 16 QPR0) local manifest for the Motorola moto g34 5G (fogos).

  This file deliberately contains ONLY the vendor/aospa override.

  All fogos device dependencies (device trees, kernel, hardware, vendor blobs) are
  declared in vendor/aospa/products/fogos/beans.xml and are synced by AOSPA's
  barista tool when you lunch aospa_fogos-userdebug. Do NOT list those projects
  here as well: barista writes its own manifest (baristablend.xml) and repo aborts
  on a duplicate path.

  Use with the AOSPA "beryl" branch:
      repo init -u https://github.com/AOSPA/manifest -b beryl
-->
<manifest>

  <remote name="fogos-gh" fetch="https://github.com/nakchwalabhi" revision="beryl" />

  <!-- AOSPA vendor config: the fork that registers the aospa_fogos product -->
  <remove-project name="AOSPA/android_vendor_aospa" />
  <project path="vendor/aospa"
           name="android_vendor_aospa"
           remote="fogos-gh" revision="beryl" />

</manifest>
