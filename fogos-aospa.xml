<?xml version="1.0" encoding="UTF-8"?>
<!--
  AOSPA "beryl" (Android 16 QPR0) local manifest for the Motorola moto g34 5G (fogos).

  Drop this into .repo/local_manifests/ and use it with the AOSPA "beryl" branch:
      repo init -u https://github.com/AOSPA/manifest -b beryl

  Contains AOSPA-source overrides + the kernel. The remaining fogos device
  dependencies (device trees, vendor blobs, hardware/motorola, SLSI NFC) are
  declared in vendor/aospa/products/fogos/beans.xml and synced by AOSPA's barista
  on lunch. Do not add those here too or repo will abort on a duplicate path.
-->
<manifest>

  <remote name="fogos-gh" fetch="https://github.com/nakchwalabhi" revision="beryl" />

  <!-- AOSPA vendor config: fork that registers the aospa_fogos product -->
  <remove-project name="AOSPA/android_vendor_aospa" />
  <project path="vendor/aospa"
           name="android_vendor_aospa"
           remote="fogos-gh" revision="beryl" />

  <!-- Device-settings resources: fork adds org.lineageos.settings.resources
       (and the "none" string) needed by Lineage's MotoActions / StylusKeyHandler -->
  <remove-project name="AOSPA/android_packages_resources_devicesettings" />
  <project path="packages/resources/devicesettings"
           name="android_packages_resources_devicesettings"
           remote="fogos-gh" revision="beryl" />

  <!-- Lineage compat shims: fork adds libgui_buffer_shim_vendor, which Motorola's
       libmot_chi_desktop_helper links against (AOSPA's compat omits it) -->
  <remove-project name="AOSPA/android_hardware_lineage_compat" />
  <project path="hardware/lineage/compat"
           name="android_hardware_lineage_compat"
           remote="fogos-gh" revision="beryl" />

  <!-- Kernel: fork adds Android.bp (Lineage ships it as "Androidbp") so Soong
       defines qti_kernel_headers -->
  <project path="kernel/motorola/sm6375"
           name="android_kernel_motorola_sm6375-2"
           remote="fogos-gh" revision="lineage-23.0" />

</manifest>
